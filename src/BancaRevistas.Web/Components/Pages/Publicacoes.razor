@page "/publicacoes"
@inject BancaApiClient Api
@inject AuthService Auth

<PageTitle>Publicações - Banca de Revistas</PageTitle>

@if (!string.IsNullOrWhiteSpace(Mensagem))
{
    <div class="alerta @(Sucesso ? "alerta-sucesso" : "alerta-erro")">
        <span>@(Sucesso ? "✓" : "⚠")</span><span>@Mensagem</span>
        <button class="btn-banca btn-secundario btn-sm ms-auto" @onclick="() => Mensagem = null">Fechar</button>
    </div>
}

<div class="card-banca mb-4">
    <div class="card-header-banca">
        <span>📰 Catálogo de publicações</span>
        @if (EhAdmin)
        {
            <button class="btn-banca btn-primario btn-sm" @onclick="AbrirNovo">+ Nova publicação</button>
        }
    </div>
    <div class="card-body-banca">
        <div class="row-form">
            <div>
                <label class="form-label">Buscar</label>
                <input class="form-control" placeholder="Título, autor ou código de barras" @bind="Busca" @bind:event="oninput" @bind:after="CarregarAsync" />
            </div>
            <div>
                <label class="form-label">Categoria</label>
                <select class="form-select" @bind="CategoriaId" @bind:after="CarregarAsync">
                    <option value="">Todas</option>
                    @foreach (var categoria in Categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nome</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Exibir</label>
                <select class="form-select" @bind="ApenasAtivos" @bind:after="CarregarAsync">
                    <option value="true">Somente ativas</option>
                    <option value="false">Todas</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card-banca">
    <div class="card-header-banca"><span>@ListaPublicacoes.Count publicação(ões)</span></div>
    <div class="card-body-banca">
        @if (ListaPublicacoes.Count == 0)
        {
            <div class="vazio"><div class="vazio-icone">📭</div><p>Nenhuma publicação encontrada.</p></div>
        }
        else
        {
            <div class="tabela-wrapper">
                <table class="tabela-banca">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Tipo</th>
                            <th>Categoria</th>
                            <th>Fornecedor</th>
                            <th class="text-end">Preço</th>
                            <th class="text-end">Custo</th>
                            <th class="text-end">Estoque</th>
                            <th>Situação</th>
                            @if (EhAdmin) { <th></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var publicacao in ListaPublicacoes)
                        {
                            <tr>
                                <td>
                                    <strong>@publicacao.Titulo</strong>
                                    @if (!string.IsNullOrWhiteSpace(publicacao.NumeroEdicao))
                                    {
                                        <div class="text-muted-banca text-pequeno">@publicacao.NumeroEdicao</div>
                                    }
                                </td>
                                <td><span class="selo selo-cinza">@publicacao.Tipo</span></td>
                                <td>@(publicacao.Categoria ?? "-")</td>
                                <td class="text-pequeno">@(publicacao.Fornecedor ?? "-")</td>
                                <td class="text-end text-dinheiro">@Valor(publicacao.Preco)</td>
                                <td class="text-end text-dinheiro text-muted-banca">@Valor(publicacao.PrecoCusto)</td>
                                <td class="text-end">
                                    <span class="selo @(publicacao.Estoque <= 0 ? "selo-vermelho" : publicacao.EstoqueCritico ? "selo-ambar" : "selo-verde")">
                                        @publicacao.Estoque
                                    </span>
                                </td>
                                <td>
                                    <span class="selo @(publicacao.Ativo ? "selo-verde" : "selo-cinza")">@(publicacao.Ativo ? "Ativa" : "Inativa")</span>
                                </td>
                                @if (EhAdmin)
                                {
                                    <td class="text-end">
                                        <button class="btn-banca btn-secundario btn-sm" @onclick="() => AbrirEdicao(publicacao)">Editar</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (MostrarModal)
{
    <div class="modal-fundo" @onclick="FecharModal">
        <div class="modal-caixa" @onclick:stopPropagation="true">
            <div class="modal-cabecalho">
                <span>@(Editando?.Id > 0 ? "Editar publicação" : "Nova publicação")</span>
                <button class="fechar-modal" @onclick="FecharModal">×</button>
            </div>
            <div class="modal-corpo">
                <div class="row-form">
                    <div style="grid-column: span 2">
                        <label class="form-label">Título *</label>
                        <input class="form-control" @bind="Formulario.Titulo" />
                    </div>
                    <div>
                        <label class="form-label">Tipo</label>
                        <select class="form-select" @bind="Formulario.Tipo">
                            @foreach (var tipo in Enum.GetValues<TipoPublicacao>())
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Categoria</label>
                        <select class="form-select" @bind="Formulario.CategoriaId">
                            <option value="">Sem categoria</option>
                            @foreach (var categoria in Categorias)
                            {
                                <option value="@categoria.Id">@categoria.Nome</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Fornecedor</label>
                        <select class="form-select" @bind="Formulario.FornecedorId">
                            <option value="">Sem fornecedor</option>
                            @foreach (var fornecedor in Fornecedores)
                            {
                                <option value="@fornecedor.Id">@fornecedor.RazaoSocial</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Autor</label>
                        <input class="form-control" @bind="Formulario.Autor" />
                    </div>
                    <div>
                        <label class="form-label">Código de barras</label>
                        <input class="form-control" @bind="Formulario.CodigoBarras" />
                    </div>
                    <div>
                        <label class="form-label">Edição</label>
                        <input class="form-control" @bind="Formulario.NumeroEdicao" placeholder="Ex.: Edição 42" />
                    </div>
                    <div>
                        <label class="form-label">Preço de venda (R$) *</label>
                        <input class="form-control" type="number" step="0.01" min="0" @bind="Formulario.Preco" />
                    </div>
                    <div>
                        <label class="form-label">Preço de custo (R$)</label>
                        <input class="form-control" type="number" step="0.01" min="0" @bind="Formulario.PrecoCusto" />
                    </div>
                    <div>
                        <label class="form-label">Estoque inicial</label>
                        <input class="form-control" type="number" min="0" @bind="Formulario.Estoque" />
                        <div class="form-hint">Registrado como entrada de estoque.</div>
                    </div>
                    <div>
                        <label class="form-label">Estoque mínimo</label>
                        <input class="form-control" type="number" min="0" @bind="Formulario.EstoqueMinimo" />
                    </div>
                </div>
            </div>
            <div class="modal-rodape">
                <button class="btn-banca btn-secundario" @onclick="FecharModal">Cancelar</button>
                <button class="btn-banca btn-primario" @onclick="SalvarAsync" disabled="@Processando">Salvar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<PublicacaoDto> ListaPublicacoes = new();
    private List<CategoriaDto> Categorias = new();
    private List<FornecedorDto> Fornecedores = new();

    private string Busca = string.Empty;
    private int? CategoriaId;
    private bool ApenasAtivos = true;

    private bool MostrarModal;
    private PublicacaoInput Formulario = new();
    private PublicacaoDto? Editando;
    private bool Processando;
    private string? Mensagem;
    private bool Sucesso;

    private bool EhAdmin => Auth.Usuario?.Permissao is PermissaoUsuario.Administrador or PermissaoUsuario.Estoquista;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
        var cats = await Api.GetListAsync<CategoriaDto>("api/categorias");
        if (cats.Sucesso && cats.Dados is not null) Categorias = cats.Dados;

        var forn = await Api.GetListAsync<FornecedorDto>("api/fornecedores");
        if (forn.Sucesso && forn.Dados is not null) Fornecedores = forn.Dados;
    }

    private async Task CarregarAsync()
    {
        var url = $"api/publicacoes?apenasAtivos={ApenasAtivos.ToString().ToLowerInvariant()}";
        if (!string.IsNullOrWhiteSpace(Busca)) url += $"&busca={Uri.EscapeDataString(Busca)}";
        if (CategoriaId.HasValue) url += $"&categoriaId={CategoriaId.Value}";

        var resultado = await Api.GetListAsync<PublicacaoDto>(url);
        if (resultado.Sucesso && resultado.Dados is not null)
            ListaPublicacoes = resultado.Dados;
    }

    private void AbrirNovo()
    {
        Editando = null;
        Formulario = new PublicacaoInput { Tipo = TipoPublicacao.Revista, EstoqueMinimo = 5 };
        MostrarModal = true;
    }

    private void AbrirEdicao(PublicacaoDto publicacao)
    {
        Editando = publicacao;
        Formulario = new PublicacaoInput
        {
            Titulo = publicacao.Titulo,
            Subtitulo = publicacao.Subtitulo,
            Autor = publicacao.Autor,
            CodigoBarras = publicacao.CodigoBarras,
            Tipo = publicacao.Tipo,
            CategoriaId = publicacao.CategoriaId,
            FornecedorId = publicacao.FornecedorId,
            Preco = publicacao.Preco,
            PrecoCusto = publicacao.PrecoCusto,
            EstoqueMinimo = publicacao.EstoqueMinimo,
            NumeroEdicao = publicacao.NumeroEdicao,
            DataPublicacao = publicacao.DataPublicacao,
            Ativo = publicacao.Ativo
        };
        MostrarModal = true;
    }

    private void FecharModal() => MostrarModal = false;

    private async Task SalvarAsync()
    {
        if (string.IsNullOrWhiteSpace(Formulario.Titulo))
        {
            Mostrar("O título é obrigatório.", false);
            return;
        }

        Processando = true;
        var resultado = Editando is null
            ? await Api.PostAsync<PublicacaoDto, PublicacaoInput>("api/publicacoes", Formulario)
            : await Api.PutAsync<PublicacaoDto, PublicacaoInput>($"api/publicacoes/{Editando.Id}", Formulario);
        Processando = false;

        if (resultado.Sucesso)
        {
            Mostrar(Editando is null ? "Publicação cadastrada com sucesso." : "Publicação atualizada.", true);
            MostrarModal = false;
            await CarregarAsync();
        }
        else
        {
            Mostrar(resultado.Mensagem, false);
        }
    }

    private void Mostrar(string mensagem, bool sucesso)
    {
        Mensagem = mensagem;
        Sucesso = sucesso;
    }

    private static string Valor(decimal valor) => valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
}
